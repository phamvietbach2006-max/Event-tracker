{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.js"
    },
    "web": {
      "root": "web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app",
        "path": "/api/$1"
      }
    },
    {
      "source": "/events",
      "destination": {
        "service": "app",
        "path": "/events"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "app",
        "path": "/auth/$1"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web",
        "path": "/$1"
      }
    }
  ]
}
